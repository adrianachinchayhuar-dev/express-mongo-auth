<%- include('partials/head', { title }) %>
<body class="auth-page" data-page="signUp">
<main class="auth-main">
    <div class="auth-shell">

        <section class="auth-visual">
            <div class="logo"><i class="material-icons">person_add</i></div>
            <h2>JOIN US</h2>
            <p class="lead">Crea tu cuenta en un minuto y empieza a usar la plataforma.</p>
            <ul>
                <li><i class="material-icons">lock</i> Contraseña cifrada con bcrypt</li>
                <li><i class="material-icons">verified_user</i> Autenticación con JWT</li>
                <li><i class="material-icons">person</i> Perfil editable</li>
            </ul>
        </section>

        <section class="auth-form-side">
            <form id="signUpForm" class="auth-form" novalidate>
                <h5 class="auth-title">CREATE ACCOUNT</h5>

                <div class="form-grid">
                    <div class="pill-field">
                        <label for="name">Nombres</label>
                        <input id="name" type="text" placeholder="Nombres" required>
                    </div>
                    <div class="pill-field">
                        <label for="lastName">Apellidos</label>
                        <input id="lastName" type="text" placeholder="Apellidos" required>
                    </div>
                    <div class="pill-field">
                        <label for="phoneNumber">Teléfono</label>
                        <input id="phoneNumber" type="tel" placeholder="987654321" required>
                    </div>
                    <div class="pill-field">
                        <label for="birthdate">Fecha de nacimiento</label>
                        <input id="birthdate" type="date" required>
                    </div>
                    <div class="pill-field full">
                        <label for="email">Email</label>
                        <input id="email" type="email" placeholder="correo@ejemplo.com" required>
                    </div>
                    <div class="pill-field full">
                        <label for="password">Contraseña</label>
                        <input id="password" type="password" placeholder="••••••••" required>
                        <span class="hint">Mínimo 8 caracteres, 1 mayúscula, 1 número y 1 especial (# $ % &amp; * @)</span>
                    </div>
                </div>

                <button class="btn waves-effect" type="submit">Registrarme</button>
                <p class="auth-link">¿Ya tienes cuenta? <a href="/signIn">Inicia sesión</a></p>
            </form>
        </section>

    </div>
</main>
<%- include('partials/foot') %>
<script src="/js/signUp.js"></script>
</body>
</html>